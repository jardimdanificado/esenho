{
  "name": "Esenho Studio Mobile",
  "short_name": "Esenho",
  "description": "Editor vetorial e raster com shell de bolso para toque",
  "start_url": "./mobile.html",
  "id": "./mobile.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "background_color": "#191c20",
